    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "react": "^19.0.0",
