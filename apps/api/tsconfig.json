{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@siescoms/certificate": ["../../packages/certificate/src/index.ts"],
      "@siescoms/certificate/*": ["../../packages/certificate/*"]
    }
  },
  "include": ["src", "tests", "api"]
}
