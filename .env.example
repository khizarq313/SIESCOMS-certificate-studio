# ==============================================================================
# SIESCOMS Certificate Studio — Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API PROJECT (Vercel Project: "apps/api" or Backend Server)
# ------------------------------------------------------------------------------
# Password staff use to sign in.
APP_PASSWORD=your_secure_password_here

# Long random string to sign auth session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_32_byte_hex_session_secret_here

# Cookie settings for cross-domain deployments (e.g. web and api on different domains)
# Set to 'none' for cross-domain HTTPS cookies; default is 'lax' for same-domain or Next rewrites.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# Port (used for local server, e.g. 4000)
API_PORT=4000

# College mail account (used for sending certificates to students/participants)
# For Microsoft 365 / College Outlook: smtp.office365.com (port 587)
# For Gmail: smtp.gmail.com (port 587)
# Note: Gmail & Microsoft 365 require an App Password (not your personal account password).
# If left empty, emails will safely route to an auto-created Ethereal test inbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=certificates@siescoms.edu
SMTP_PASS=your_app_password
SMTP_FROM="SIES College of Management Studies <certificates@siescoms.edu>"

# ------------------------------------------------------------------------------
# 2. WEB FRONTEND PROJECT (Vercel Project: "apps/web")
# ------------------------------------------------------------------------------
# Pass the full URL of your deployed API project on Vercel (without trailing slash).
# Next.js rewrites forward all /api requests from the browser to this backend.
API_URL=https://siescoms-certificate-studio-api.vercel.app

# Optional: Direct client API URL fallback
NEXT_PUBLIC_API_URL=https://siescoms-certificate-studio-api.vercel.app
