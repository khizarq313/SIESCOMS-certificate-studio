# Copy to .env and fill in.

# Password staff use to sign in.
APP_PASSWORD=
# Long random string that signs sign-in cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Port for the API (the web app runs on 3000 and forwards /api here).
API_PORT=4000

# College mail account ("Send from: College mail account").
# For Microsoft 365 / College Outlook: smtp.office365.com (port 587)
# For personal Gmail: smtp.gmail.com (port 587)
# Note: Requires an App Password (not your standard account password).
# Leave empty during development: emails then go to a free Ethereal test inbox.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SIES College of Management Studies <your-email@siescoms.edu>"
